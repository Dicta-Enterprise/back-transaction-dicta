generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model carrito {
  id             Int                   @id @default(autoincrement())
  idusuario      Int
  createdat      DateTime              @default(now()) @db.Timestamp(6)
  updatedat      DateTime              @default(now()) @updatedAt @db.Timestamp(6)
  estado         String                @default("PENDIENTE") @db.VarChar(20)
  usuarios       usuarios              @relation(fields: [idusuario], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_carrito_usuario")
  cursos         carritoCurso[]
  notificaciones notificacioncarrito[]
}

model carritoCurso {
  id        Int     @id @default(autoincrement())
  carritoId Int
  idcurso   String  @db.Char(24)
  carrito   carrito @relation(fields: [carritoId], references: [id], onDelete: Cascade)
}

model notificacioncarrito {
  id        Int      @id @default(autoincrement())
  idcarrito Int
  enviadoat DateTime @default(now()) @db.Timestamp(6)
  messageid String?  @db.VarChar(200)
  secuencia Int      @default(1)
  carrito   carrito  @relation(fields: [idcarrito], references: [id], onDelete: Cascade)
}

model eventoCorreo {
  id        Int      @id @default(autoincrement())
  messageid String?  @db.VarChar(200)
  evento    String   @db.VarChar(50)
  email     String?  @db.VarChar(150)
  createdat DateTime @default(now()) @db.Timestamp(6)
}

model accesos {
  id            Int       @id @default(autoincrement())
  idrol         Int
  fechacreacion DateTime?
  estado        Int?      @db.SmallInt
  descripcion   String?   @db.VarChar(200)
  rol           rol       @relation(fields: [idrol], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_accesos_rol")
}

model departamento {
  id              Int         @id @default(autoincrement())
  idpais          Int
  nombre          String      @db.VarChar(80)
  estado          Int         @default(1) @db.SmallInt
  fechacreacion   DateTime    @default(now()) @db.Timestamp(6)
  fechaactualizar DateTime?   @db.Timestamp(6)
  pais            pais        @relation(fields: [idpais], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_departamento_pais")
  provincia       provincia[]
}

model detalleorden {
  id          Int     @id @default(autoincrement())
  idorden     Int
  idcurso     String  @db.Char(24)
  precio      Decimal @db.Decimal(12, 2)
  nombrecurso String? @db.VarChar(150)
  orden       orden   @relation(fields: [idorden], references: [id])
}

model orden {
  id            Int            @id @default(autoincrement())
  idusuario     Int
  fechacreacion DateTime       @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  estado        String         @db.VarChar(20)
  detalleorden  detalleorden[]
  usuario       usuarios       @relation(fields: [idusuario], references: [id])
  pagos         pagos?
}

model pagos {
  id              Int      @id @default(autoincrement())
  idorden         Int      @unique(map: "uq_pagos_idorden")
  metodopago      String   @db.VarChar(10)
  fechapago       DateTime @db.Timestamp(6)
  monto           Decimal  @db.Decimal(12, 2)
  estado          String   @default("PENDIENTE")
  nrcompra        Int?     @default(autoincrement())
  tipotarjeta     String?  @db.VarChar(20)
  nombrepagante   String?  @db.VarChar(100)
  emailpagante    String?  @db.VarChar(150)
  transactionid   String?  @db.VarChar(150)
  moneda          String?  @db.VarChar(10)
  processing_mode String?  @default("automatic")
  orden           orden    @relation(fields: [idorden], references: [id])
}

model pais {
  id              Int            @id @default(autoincrement())
  nombre          String         @db.VarChar(80)
  estado          Int            @default(1) @db.SmallInt
  fechacreacion   DateTime       @default(now()) @db.Timestamp(6)
  fechaactualizar DateTime?      @db.Timestamp(6)
  departamento    departamento[]
  persona         persona[]
}

model perfil {
  id        Int       @id @default(autoincrement())
  nombre    String?   @db.VarChar(50)
  password  String?   @db.VarChar(50)
  estado    Int?      @db.SmallInt
  imageurl  String?   @db.VarChar(100)
  idusuario Int?
  idrol     Int?
  rol       rol?      @relation(fields: [idrol], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios  usuarios? @relation(fields: [idusuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model persona {
  id           Int       @id @default(autoincrement())
  nombre       String?   @db.VarChar(50)
  apellidopat  String?   @db.VarChar(50)
  apellidomat  String?   @db.VarChar(50)
  documento    Int?
  telefono     Int?
  idusuario    Int?
  codigopostal String?   @db.VarChar(10)
  idpais       Int?
  pais         pais?     @relation(fields: [idpais], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_persona_pais")
  usuarios     usuarios? @relation(fields: [idusuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model provincia {
  id              Int          @id @default(autoincrement())
  iddepartamento  Int
  nombre          String       @db.VarChar(80)
  estado          Int          @default(1) @db.SmallInt
  fechacreacion   DateTime     @default(now()) @db.Timestamp(6)
  fechaactualizar DateTime?    @db.Timestamp(6)
  departamento    departamento @relation(fields: [iddepartamento], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_provincia_departamento")
}

model rol {
  id          Int        @id
  nombrerol   String?    @db.VarChar(50)
  estado      Int?       @db.SmallInt
  descripcion String?    @db.VarChar(200)
  tipo        String?    @db.VarChar(50)
  accesos     accesos[]
  perfil      perfil[]
  usuarios    usuarios[]
}

model usuarios {
  id                Int       @id @default(autoincrement())
  username          String?   @db.VarChar(50)
  email             String?   @db.VarChar(50)
  password          String?   @db.VarChar(50)
  confirmarpassword String?   @db.VarChar(50)
  fechadecreacion   DateTime?
  estado            Int?      @db.SmallInt
  idrol             Int?
  carrito           carrito[]
  orden             orden[]
  perfil            perfil[]
  persona           persona[]
  rol               rol?      @relation(fields: [idrol], references: [id], onDelete: NoAction, onUpdate: NoAction)
}