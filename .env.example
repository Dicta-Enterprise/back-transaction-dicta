# ─── MercadoPago ─────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-...
MP_webhook_TOKEN=your_mp_webhook_secret

# ─── Factus (Halltec) ────────────────────────────
# Credenciales OAuth2 que te entrega Factus al registrarte
FACTUS_USERNAME=tu_usuario_factus
FACTUS_PASSWORD=tu_password_factus
FACTUS_CLIENT_ID=tu_client_id
FACTUS_CLIENT_SECRET=tu_client_secret

# ID del rango de numeración creado en el panel de Factus
# (Configuración → Rangos de numeración → ver columna "ID")
FACTUS_NUMBERING_RANGE_ID=4

# Datos de tu establecimiento (emisor de la factura)
FACTUS_ESTABLISHMENT_NAME=Mi Empresa S.A.S
FACTUS_ESTABLISHMENT_ADDRESS=Calle 10 # 3-13
FACTUS_ESTABLISHMENT_PHONE=6011234567
FACTUS_ESTABLISHMENT_EMAIL=facturacion@miempresa.com

# ID de municipio DANE de tu establecimiento
# 980 = Bogotá  149 = Medellín  76001 = Cali …
# Consulta la lista completa en: developers.factus.com.co → Tablas de referencia
FACTUS_MUNICIPALITY_ID=149
